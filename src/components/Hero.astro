---
import Section from "./Section.astro";
import { phone, licence, address } from "../data/clinic";
const h1 = "Офтальмологічний центр «АЙЛАЗ» у Києві — від обстеження до операції";
---
<Section id="hero" class="hero" rec="R-102,R-107,R-108">
  <div class="container hero__grid">
    <h1 class="hero__title">{h1}</h1>
    <p class="hero__lede t-lede">Лазерна корекція зору, катаракта, дитячий зір і хвороби ока з відкритими цінами в гривнях, а запис — одним дзвінком у кол-центр.</p>

    <div class="hero__call" data-rec="R-101,R-102,S-R014,S-R-MA03">
      <a class="disc" href={phone.href}>
        <span class="disc__ring" aria-hidden="true"></span>
        <span class="disc__dot" aria-hidden="true"></span>
        <span class="disc__label">Подзвонити</span>
        <span class="disc__num num">{phone.display}</span>
      </a>
      <p class="hero__hours t-small muted">{phone.hours}</p>
    </div>

    <div class="hero__meta">
      <a class="text-link hero__next" href="#directions">Обрати напрямок</a>
      <p class="t-small muted">{licence}</p>
      <p class="t-small muted">{address.street}, {address.metro}</p>
    </div>
  </div>
</Section>

<style>
  :global(.hero) { padding-block: var(--s-7) var(--section-xl); }
  .hero__grid {
    display: grid; grid-template-columns: minmax(0, 1fr);
    row-gap: var(--s-6);
  }
  .hero__title { font-size: min(var(--fs-display), 8.8vw); line-height: var(--lh-display); letter-spacing: -0.01em; max-width: 18ch; text-wrap: balance; }
  .hero__lede { max-width: 44ch; }
  .hero__meta { display: grid; gap: var(--s-1); }
  .hero__next { justify-self: start; display: inline-flex; align-items: center; min-height: var(--tap); margin-bottom: var(--s-2); }
  .hero__hours { margin-top: var(--s-2); }

  /* Fixation disc. On phones it is a full-width capsule (64px) with a graphite dot. */
  .disc {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: var(--s-3);
    min-height: var(--tap-l); padding: var(--s-3) var(--s-5);
    border-radius: var(--radius-pill);
    background: var(--color-accent); color: var(--color-accent-ink);
    text-decoration: none;
    box-shadow: 0 0 0 0 var(--color-text);
    transition: box-shadow var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .disc:hover { box-shadow: 0 0 0 2px var(--color-text); }
  .disc:active { transform: scale(.98); }
  .disc__dot { grid-row: span 2; width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent-ink); }
  .disc__label { font-weight: 600; font-size: var(--fs-body); line-height: 1.2; }
  .disc__num { font-size: var(--fs-body); line-height: 1.3; }
  .disc__ring { display: none; }

  @media (max-width: 767px) {
    .disc { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0 var(--s-3); }
    .disc__dot { flex: none; }
  }

  @media (min-width: 768px) {
    :global(.hero) { padding-top: var(--s-9); }
    .hero__grid { grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--gutter); }
    .hero__title { grid-column: 1 / -1; }
    .hero__lede { grid-column: 1 / 6; align-self: center; }
    .hero__call { grid-column: 6 / -1; grid-row: 2 / 4; justify-self: end; display: grid; justify-items: center; }
    .hero__meta { grid-column: 1 / 6; }
    .disc {
      width: var(--disc-s); height: var(--disc-s); min-height: 0; padding: var(--s-4);
      border-radius: 50%;
      grid-template-columns: 1fr; justify-items: center; align-content: center; text-align: center; row-gap: var(--s-1);
    }
    .disc__dot { display: none; }
    .disc__ring { display: block; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid var(--color-text); opacity: 0; z-index: -1; pointer-events: none; }
    .disc__label { font-size: var(--fs-body); }
    .disc__num { font-size: var(--fs-small); }
  }
  @media (min-width: 1280px) {
    :global(.hero) { padding-top: var(--s-8); }
    .hero__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .hero__title { grid-column: 1 / 11; max-width: none; }
    .hero__lede { grid-column: 1 / 8; }
    .hero__meta { grid-column: 1 / 8; }
    .hero__call { grid-column: 10 / -1; grid-row: 2 / 4; justify-self: center; align-self: start; }
    .disc { width: var(--disc); height: var(--disc); }
    .disc__label { font-size: var(--fs-body); }
    .disc__num { font-size: var(--fs-body); }
  }

  /* Motion 1 — «focusing»: the ring closes on the disc once, the disc settles. Text is never delayed. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .disc { animation: disc-settle var(--dur-focus) var(--ease-out) both; }
    .disc__ring { animation: ring-focus var(--dur-focus) var(--ease-out) 120ms both; }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 767px) {
    .disc { animation: disc-settle 480ms var(--ease-out) both; }
  }
  @keyframes disc-settle { from { transform: scale(.94); } to { transform: scale(1); } }
  @keyframes ring-focus {
    0% { transform: scale(1.5); opacity: 0; }
    60% { opacity: 1; }
    100% { transform: scale(1); opacity: 0; }
  }
</style>
